"text": "Do you know where to go?",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 66.0,
"end": 68.0,
"text": "Oh, I don't know.",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 68.0,
"end": 70.0,
"text": "Have you had lunch?",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 70.0,
"end": 72.0,
"text": "I have had lunch.",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 74.0,
"end": 76.0,
"text": "Looking grand.",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 76.0,
"end": 78.0,
"text": "Now wait a minute.",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 78.0,
