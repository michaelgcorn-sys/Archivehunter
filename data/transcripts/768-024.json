},
{
"start": 58.6,
"end": 59.5,
"text": "All right.",
"conf": -0.67,
"no_speech": 0.75
},
{
"start": 60.0,
"end": 62.0,
"text": "Have you been waiting an hour?",
"conf": -0.44,
"no_speech": 0.56
},
{
"start": 62.0,
